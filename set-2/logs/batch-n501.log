for job in jobs:
    target = root / job[\"file\"]
    if target.exists():
        raise SystemExit(f\"Destination unexpectedly exists: {target}\")
    subprocess.run([\"sips\", \"-s\", \"format\", \"png\", \"-z\", \"1024\", \"1024\", job[\"source\"], \"--out\", str(target)], check=True, capture_output=True, text=True)
    data = target.read_bytes()
    assert data[:8] == b\"\\x89PNG\\r\\n\\x1a\\n\", target
    dimensions = struct.unpack(\">II\", data[16:24])
    assert dimensions == (1024, 1024), (target, dimensions)
    print(f\"{target.name}: PNG {dimensions[0]}x{dimensions[1]}, {len(data):,} bytes\")

